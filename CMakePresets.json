{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio Community 2026",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_GENERATOR_INSTANCE": "C:/Program Files/Microsoft Visual Studio/18/Community",
        "UNLEASHED_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "selftests",
      "inherits": "vs2026",
      "displayName": "Optional offline regressions",
      "binaryDir": "${sourceDir}/../../04_SCENARIO/un-dma-v2/build/selftests",
      "cacheVariables": {
        "UNLEASHED_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vs2026",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "vs2026",
      "configuration": "Debug"
    },
    {
      "name": "selftests",
      "configurePreset": "selftests",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "selftests",
      "configurePreset": "selftests",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
